# Copy to .env and fill in. .env is gitignored and must not be shared.

# --- the voice model -------------------------------------------------------
# platform.openai.com -> API keys. Realtime audio is billed per minute of audio.
# `npm run preflight` opens a real session with this key and tells you whether the
# model name, the audio format and the event names are right.
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=alloy

# --- where the finished application goes ------------------------------------
REPORT_TO=you@example.com

# Gmail API credentials for sending that email: an OAuth client plus a refresh
# token carrying a send scope. `npm run preflight` checks the token refreshes.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- the phone -------------------------------------------------------------
# Only needed for tools/twilio-setup.js, which buys a number and points it here.
# The bot itself needs no Twilio credentials: inbound calls are Twilio calling us.
#
# NOTE: <Connect><Stream> is blocked on a Twilio trial account. A trial number
# fetches this server's TwiML and then hangs up without opening the audio socket.
# The account has to be upgraded before a call can work.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# SignalWire instead of Twilio. Same markup, same stream protocol, same frames, so
# nothing in src/ changes: set CARRIER=signalwire and the markup names the codec and
# asks for realtime pacing, which is all the two carriers disagree about. The space
# is the host in your dashboard URL, e.g. example.signalwire.com.
# Used by tools/signalwire-setup.js to buy a number and point it here.
SIGNALWIRE_SPACE=
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=

# twilio (default) or signalwire.
CARRIER=twilio

# The public HTTPS URL the carrier should POST to, ending in /incoming-call.
# With a quick tunnel: cloudflared tunnel --url http://localhost:5050
PUBLIC_WEBHOOK_URL=

# --- behaviour ---------------------------------------------------------------
PORT=5050

# 1 (default): ask all five screening questions, then stop the call if any of them
#   trips a reject rule, so a declined applicant is never asked for a social
#   security number or a bank account.
# 0: ask all 24 questions before deciding, which is the literal reading of the brief.
EARLY_KNOCKOUT=1
